# ==============================================================================
# Google Cloud Platform (GCP) & BigQuery Configuration
# ==============================================================================

# Required: The Google Cloud Project ID used to run and bill BigQuery queries.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional: Default geographic location for BigQuery jobs/datasets (default: US).
BIGQUERY_LOCATION=US

# Optional: BigQuery table ID for RUM Archive page loads
RUMARCHIVE_TABLE=cf-open-web-performance.rumarchive.rumarchive_page_loads

# ==============================================================================
# Authentication Options
# ==============================================================================
#
# Option A: Local Development with gcloud CLI (Recommended for local dev)
# ----------------------------------------------------------------------
# Run the following once on your workstation:
#   gcloud auth application-default login
#   gcloud config set project your-gcp-project-id
# No credential variables are needed below; Google ADC will automatically detect your login.
#
# Option B: Service Account Key File Path
# ---------------------------------------
# Relative or absolute path to a downloaded GCP service account JSON key file:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
#
# Option C: Service Account Key JSON Content (Recommended for GitHub Actions Secrets)
# ----------------------------------------------------------------------------------
# Raw JSON string containing the service account key (useful as GitHub secret GCP_SA_KEY):
# GCP_SA_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
#
# Option D: Workload Identity Federation (Keyless auth for GitHub Actions)
# -----------------------------------------------------------------------
# Used with google-github-actions/auth in CI:
# GCP_WORKLOAD_IDENTITY_PROVIDER=projects/1234567890/locations/global/workloadIdentityPools/github-pool/providers/github-provider
# GCP_SERVICE_ACCOUNT=github-actions-sa@your-gcp-project-id.iam.gserviceaccount.com
