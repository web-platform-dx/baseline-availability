<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {# Note: frame-ancestors is omitted from <meta> CSP because browsers only support it via HTTP response headers #}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self'; img-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'self';">
  <title>{{ title or site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="stylesheet" href="/css/styles.css">
  <script src="/assets/js/baseline-initial-data.js" defer></script>
  <script src="/assets/js/baseline-browser-breakdown.js" defer></script>
  <script src="/assets/js/baseline-components.js" defer></script>
</head>
<body>
  <div class="warning-banner" role="region" aria-label="Work in progress warning">
    <div class="container warning-banner-inner">
      <strong>WARNING:</strong> This page is a work in progress. The underlying data set is still being tuned for accuracy. Aggregation techniques are subject to change. <a href="https://github.com/web-platform-dx/baseline-availability/issues" rel="noopener noreferrer" target="_blank">Please file issues here</a>.
    </div>
  </div>
  <header class="site-header">
    <div class="container header-inner">
      <div class="brand">
        <img src="/assets/img/baseline-widely-icon.svg" alt="" class="brand-logo" width="28" height="16">
        <a href="/" class="brand-title">{{ site.title }}</a>
        <span class="org-badge">{{ site.organization }}</span>
      </div>
      <nav class="header-nav" aria-label="Primary navigation">
        <button
          type="button"
          class="theme-toggle-btn"
          id="theme-toggle"
          aria-label="Switch to dark theme"
          aria-pressed="false"
        >
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
          <span class="theme-toggle-label" id="theme-toggle-label">Dark</span>
        </button>
        <a href="{{ site.repositoryUrl }}" class="nav-link" rel="noopener noreferrer" target="_blank">GitHub</a>
      </nav>
    </div>
  </header>

  <main class="container main-content" id="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p>Maintained by the <strong>{{ site.organization }}</strong> organization.</p>
    </div>
  </footer>
</body>
</html>
