<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {# Note: frame-ancestors is omitted from <meta> CSP because browsers only support it via HTTP response headers #}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self'; img-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'self';">
  <title>{{ title or site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="stylesheet" href="/css/styles.css">
  {% if includeFeaturesBundle %}
  <script src="/assets/js/baseline-features-data.js" defer></script>
  {% elif not skipDefaultDataBundles %}
  <script src="/assets/js/baseline-initial-data.js" defer></script>
  <script src="/assets/js/baseline-browser-breakdown.js" defer></script>
  {% endif %}
  <script src="/assets/js/baseline-components.js" defer></script>
</head>
<body>
  <div id="app-shell" class="app-shell">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="warning-banner" role="region" aria-label="Work in progress warning">
      <div class="container warning-banner-inner">
        <strong>WARNING:</strong> This page is a work in progress. The underlying data set is still being tuned for accuracy. Aggregation techniques are subject to change. <a href="https://github.com/web-platform-dx/baseline-availability/issues" rel="noopener noreferrer" target="_blank">Please file issues here<span class="sr-only"> (opens in a new tab)</span></a>.
      </div>
    </div>
    <header class="site-header">
      <div class="container header-inner">
        <div class="brand">
          <button
            type="button"
            id="drawer-open"
            class="drawer-open-btn"
            aria-label="Menu"
            aria-expanded="false"
            aria-controls="drawer"
            title="Open navigation menu"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
          <img src="/assets/img/baseline-widely-icon.svg" alt="" class="brand-logo" width="28" height="16" aria-hidden="true">
          <a href="/" class="brand-title">{{ site.title }}</a>
          <span class="org-badge">{{ site.organization }}</span>
        </div>
        <nav class="header-nav" aria-label="Primary navigation">
          <button
            type="button"
            class="theme-toggle-btn"
            id="theme-toggle"
            aria-label="Switch to dark theme"
            aria-pressed="false"
          >
            <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
            <span class="theme-toggle-label" id="theme-toggle-label">Dark</span>
          </button>
          <a href="{{ site.repositoryUrl }}" class="nav-link" rel="noopener noreferrer" target="_blank">GitHub<span class="sr-only"> (opens in a new tab)</span></a>
        </nav>
      </div>
    </header>

    <main class="container main-content" id="main-content">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>Maintained by the <strong>{{ site.organization }}</strong> organization.</p>
      </div>
    </footer>
  </div>

  <div class="Drawer" id="drawer" popover="manual" role="dialog" aria-modal="true" aria-label="Navigation menu">
    <div class="Drawer-scroller">
      <nav class="Drawer-sheet" tabindex="-1" aria-label="Views">
        <div class="Drawer-header">
          <div class="Drawer-brand">
            <img src="/assets/img/baseline-widely-icon.svg" alt="" class="brand-logo" width="26" height="15" aria-hidden="true">
            <span class="Drawer-title">{{ site.title }}</span>
          </div>
          <button
            type="button"
            class="Drawer-close"
            id="drawer-close"
            aria-label="Close menu"
            title="Close menu"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="Drawer-body">
          <p class="Drawer-section-label" id="drawer-views-heading">Navigation</p>
          <ul class="Drawer-list" aria-labelledby="drawer-views-heading">
            <li class="Drawer-item">
              <a
                href="/"
                class="Drawer-link{% if page.url == '/' %} is-active{% endif %}"
                {% if page.url == '/' %}aria-current="page"{% endif %}
              >
                <svg class="Drawer-link-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="18" y1="20" x2="18" y2="10"></line>
                  <line x1="12" y1="20" x2="12" y2="4"></line>
                  <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
                <span class="Drawer-link-text">
                  <span class="Drawer-link-title">Baseline stats</span>
                  <span class="Drawer-link-subtitle">Aggregate availability &amp; browser breakdown</span>
                </span>
              </a>
            </li>
            <li class="Drawer-item">
              <a
                href="/regions/"
                class="Drawer-link{% if page.url and page.url.startsWith('/regions') %} is-active{% endif %}"
                {% if page.url and page.url.startsWith('/regions') %}aria-current="page"{% endif %}
              >
                <svg class="Drawer-link-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
                <span class="Drawer-link-text">
                  <span class="Drawer-link-title">Regions &amp; countries</span>
                  <span class="Drawer-link-subtitle">Top-level stats across UN M49 regions &amp; {{ baseline_country_summary.countryCount if baseline_country_summary and baseline_country_summary.countryCount else 243 }} countries</span>
                </span>
              </a>
            </li>
            <li class="Drawer-item">
              <a
                href="/features/"
                class="Drawer-link{% if page.url and page.url.startsWith('/features') %} is-active{% endif %}"
                {% if page.url and page.url.startsWith('/features') %}aria-current="page"{% endif %}
              >
                <svg class="Drawer-link-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                  <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                  <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                  <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                </svg>
                <span class="Drawer-link-text">
                  <span class="Drawer-link-title">Features</span>
                  <span class="Drawer-link-subtitle">Individual support across {{ baseline_features.counts.total if baseline_features and baseline_features.counts else 1214 }} web-features</span>
                </span>
              </a>
            </li>
          </ul>
        </div>

        <div class="Drawer-footer">
          <a href="{{ site.repositoryUrl }}" class="Drawer-footer-link" rel="noopener noreferrer" target="_blank">
            <span>View source on GitHub</span>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </nav>
    </div>
  </div>
</body>
</html>
